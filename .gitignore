# Node dependencies
node_modules/
dist/
npm-debug.log

# Python dependencies
__pycache__/
*.py[cod]
venv/
env/

# Secrets (CRITICAL)
.env
.env.local

# OS Files
.DS_Store

# Agent-generated output (the Engine writes here at runtime; keep the repo
# clean of whatever prompts happen to produce). Files already committed
# before this rule stay tracked.
/workspace/*
!/workspace/.gitkeep